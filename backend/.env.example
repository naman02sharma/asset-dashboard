# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/asset_dashboard

# --- Server ---
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# --- Auth ---
# Any long random string — used to sign login tokens. Change this for production.
JWT_SECRET=change-this-to-a-long-random-string

# --- SMS notifications (optional — mocked until you add Twilio credentials) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Gmail notifications (Nodemailer) ---
# Use a Google "App Password", not your normal Gmail password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
GMAIL_USER=your-notifications@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
NOTIFY_TO_EMAIL=procurement-team@yourcompany.com

# --- Business rules ---
# Days before expected_delivery_date to send a "delivery approaching" style check.
OVERDUE_CHECK_CRON=0 8 * * *
